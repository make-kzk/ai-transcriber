#!/bin/bash
# Облачная транскрибация аудио с разделением по ролям на базе Modal GPU (WhisperX + Pyannote)

if command -v modal &> /dev/null; then
    MODAL_BIN="$(command -v modal)"
elif [ -f "$HOME/.modal-venv/bin/modal" ]; then
    MODAL_BIN="$HOME/.modal-venv/bin/modal"
elif [ -f "$HOME/.local/bin/modal" ]; then
    MODAL_BIN="$HOME/.local/bin/modal"
else
    echo "Ошибка: Утилита modal не найдена. Запустите install.sh"
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/transcribe_modal.py" ]; then
    SCRIPT_PATH="$SCRIPT_DIR/transcribe_modal.py"
elif [ -f "$HOME/.local/bin/transcribe_modal.py" ]; then
    SCRIPT_PATH="$HOME/.local/bin/transcribe_modal.py"
else
    echo "Ошибка: transcribe_modal.py не найден."
    exit 1
fi

if [ -z "$1" ]; then
    echo "Использование: transcribe <аудиофайл> [--speakers N] [--language ru]"
    echo "Пример: transcribe meeting.m4a"
    echo "        transcribe meeting.m4a --speakers 2"
    exit 1
fi

FILE="$1"
shift

exec "$MODAL_BIN" run "$SCRIPT_PATH" --file "$FILE" "$@"
